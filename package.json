{
  "name": "local-agent-runner",
  "version": "1.0.0",
  "description": "",
  "main": "dist/electron/main/main.js",
  "scripts": {
    "clean": "rimraf dist",
    "clean:renderer": "rimraf dist/renderer",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.renderer.json && tsc -p tsconfig.electron.json && tsc -p tsconfig.scripts.json",
    "build": "npm run clean && npm run typecheck && vite build",
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"npm run dev:electron\"",
    "dev:electron": "wait-on http://localhost:5173 dist/electron/main/main.js dist/electron/preload/preload.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 nodemon --watch dist/electron --ext js,json --exec electron .",
    "start": "npm run build && electron .",
    "start:built": "electron .",
    "inspect:workspace": "tsx scripts/inspect-workspace.ts",
    "runs:start": "tsx scripts/runs-start-script.ts",
    "runs:cancel": "tsx scripts/runs-cancel.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ansi_up": "^6.0.6",
    "dayjs": "^1.11.21",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^41.6.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "wait-on": "^9.0.10"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
